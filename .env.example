# 复制成 .env 后填入自己的 key：cp .env.example .env
# .env 已在 .gitignore 里，不会被提交。

# DeepSeek 的 key（必填，格式 sk-xxxxxxxx）
DEEPSEEK_API_KEY=

# 下面三项都有默认值，一般不用改。
# 因为走的是 OpenAI 兼容协议，换成 Kimi / 通义 / 本地 Ollama 只需要改这两行。
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 网页拖入材料的上限（可选）。
# 材料会一次性发给模型做提炼，调高前请确认模型的上下文足够大。
# 默认：5 万字 / 50 份 / 单份 10 MB。
# 1M 上下文模型可以这样设：
# DUO_FORGE_MAX_MATERIAL=1000000
# DUO_FORGE_MAX_MATERIAL_FILES=50
# DUO_FORGE_MAX_MATERIAL_FILE_BYTES=10485760
